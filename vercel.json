{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/invite/:code", "destination": "/invite" },
    { "source": "/driver-invite/:code", "destination": "/driver-invite" },
    { "source": "/c/:code", "destination": "/creator" }
  ],
  "redirects": [
    {
      "_comment": "Creator code renamed DANIEL -> THECHITOMBIS on 2026-09-08, hours after it was created, at his request. Without this the OLD link still RENDERS - /c/:code is a generic page that reads the code out of the URL - while the lookup 404s, so the badge goes unnamed and anyone signing up with DANIEL is attributed to NOBODY and he is paid nothing. A page that looks fine and pays nobody is the exact silent-failure shape. Safe to delete once nothing points at /c/DANIEL any more; harmless to leave.",
      "source": "/c/DANIEL",
      "destination": "/c/THECHITOMBIS",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://admin.halamove.co.za/admin/",
      "permanent": false
    },
    {
      "source": "/business",
      "destination": "/business-transport-durban",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/brand-manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}